# Application Environment
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Audio / Whisper Engine Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_SIZE_BYTES=26214400

# Persistence (SQLite 100% parametrizado e multi-tenant)
DATABASE_PATH=audio_prompt_engine.db

# Security & RBAC: API Keys mapping (JSON format)
# Format: {"<API_KEY>": {"tenant_id": "<TENANT_ID>", "role": "<viewer|operator|admin>"}}
API_KEYS_CONFIG={"dev-operator-alpha":{"tenant_id":"tenant-alpha","role":"operator"},"dev-viewer-alpha":{"tenant_id":"tenant-alpha","role":"viewer"},"dev-operator-beta":{"tenant_id":"tenant-beta","role":"operator"}}
