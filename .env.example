# Application Environment
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Audio / Whisper Engine Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_SIZE_BYTES=26214400

# Persistence (SQLite 100% parametrizado e multi-tenant)
# Local: audio_prompt_engine.db | Docker container: data/audio_prompt_engine.db
DATABASE_PATH=data/audio_prompt_engine.db

# LLM Execution Engine Configuration (Ollama Local, Grok, Gemini, Groq)
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_OLLAMA_MODEL=llama3
DEFAULT_GROK_MODEL=grok-beta
DEFAULT_GEMINI_MODEL=gemini-1.5-flash
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
# XAI_API_KEY=your-xai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# Security & RBAC: API Keys mapping (JSON format)
# Format: {"<API_KEY>": {"tenant_id": "<TENANT_ID>", "role": "<viewer|operator|admin>"}}
API_KEYS_CONFIG={"dev-operator-alpha":{"tenant_id":"tenant-alpha","role":"operator"},"dev-viewer-alpha":{"tenant_id":"tenant-alpha","role":"viewer"},"dev-operator-beta":{"tenant_id":"tenant-beta","role":"operator"}}

